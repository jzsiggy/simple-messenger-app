# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable (anon) key — sb_publishable_..., NEVER the sb_secret_ key
VITE_SUPABASE_KEY=

# ISO-639-1 language code for voice transcription, e.g. pt
VITE_LANG=pt

# Name shown in the chat header
VITE_CHAT_NAME=Chat
